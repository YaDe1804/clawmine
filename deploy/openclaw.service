[Unit]
Description=OpenClaw Gateway (local-only)
Documentation=https://docs.openclaw.ai
After=network-online.target ollama.service
Wants=network-online.target ollama.service

[Service]
Type=simple
User=openclaw
Group=openclaw
WorkingDirectory=/opt/openclaw
EnvironmentFile=/etc/openclaw/openclaw.env
ExecStart=node /opt/openclaw/dist/cli.js gateway start
Restart=always
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/openclaw /var/lib/openclaw /home/openclaw

[Install]
WantedBy=multi-user.target
